# BPI Router Linux Build Configuration Template
# This file will be processed by config_dialog.sh to generate build.conf

# Upload Configuration
uploaduser=$USER
uploadserver=r3
uploaddir=/var/lib/tftp

# Build Configuration  
builddir=../build
ramdisksize=8G
#numproc=${NUM_PROC}

# Board Selection (uncomment one)
board=bpi-r4
#board=bpi-r64
#board=bpi-r2pro
#board=bpi-r3
#board=bpi-r3mini
#board=bpi-r4
#board=bpi-r4pro
#board=bpi-r4lite

# Board Version (uncomment if needed)
#r64 with rtl8367
#boardversion=v0.1
#r2pro with rtl8367
#boardversion=v00

# Architecture Settings
#mainline uboot for r64 (old ATF) needs 64bit uImage
#uimagearch=arm64

# Module Configuration
#grep whitelist filter for adding modules to initramfs
ownmodules='${OWN_MODULES}'
